# Pixi Configuration Files
# Root pixi.toml (workspace-level):
# Defines shared settings in [workspace] (e.g., channels, platforms). Uses [package.run-dependencies] for sub-package paths (e.g., subpkg = { path = "./subpkg" }). Manages overall metadata, environments, and features.
# Sub-package pixi.toml (package-level):
# Lightweight; includes [project] for package metadata (name, version, description), [dependencies] (Conda/PyPI), [tasks], and [package] for buildable details (build/host/run deps). Inherits workspace settings; no repeated config.
# Root Control of Sub-Workspaces
# Yes; root resolves dependencies across all, executes tasks/builds (via pixi run/pixi-build), and ensures shared environments. Sub-packages focus on specifics.

[workspace]
name = "cbp"
authors = ["Peter Alexander <makeroftools@creativedevelopment.systems>"]
channels = ["https://prefix.dev/pixi-build-backends", "https://conda.modular.com/max-nightly", "conda-forge"]
platforms = ["linux-64"]
