[package]
name = "cbp-rust"
version = "0.1.0"
edition = "2024"


[[bin]]
name = "cbp-rust"
path = "src/binance/main.rs"

[dependencies]
async-graphql = "7.0.17"
async-graphql-poem = "7.0.17"
criterion = "0.7.0"
poem = "3.1.12"
slab = "0.4.11"
tokio = {version = "1.48.0", features = ["rt-multi-thread", "macros"] }
binance-sdk = { version = "1.0.0", features = ["spot"] }
serde_json = { version = "1.0.145", features = ["preserve_order"] }
tokio-tungstenite = { version = "0.28.0", features = ["native-tls"] }
tokio-stream = "0.1.17"
futures-util = "0.3.31"
binance = { version = "0.21.2" }


